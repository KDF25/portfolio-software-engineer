# Публичный адрес сайта (база для OG-картинок)
NEXT_PUBLIC_SITE_URL=https://example.com

# Контакты на сайте
NEXT_PUBLIC_CONTACT_EMAIL=
# Имя пользователя Telegram без @
NEXT_PUBLIC_CONTACT_TELEGRAM=
# Часть адреса профиля после linkedin.com/in/
NEXT_PUBLIC_CONTACT_LINKEDIN=
NEXT_PUBLIC_CONTACT_GITHUB=

# Google Tag Manager (GTM-XXXXXXX), GA4 настроен внутри контейнера; пусто — аналитика выключена
NEXT_PUBLIC_GTM_ID=

# Подтверждение прав в Google Search Console и Яндекс Вебмастере (только код из meta-тега); пусто — тег не выводится
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
